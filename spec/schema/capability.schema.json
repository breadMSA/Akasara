{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akasara.dev/spec/0.1/capability.schema.json",
  "title": "ASE-0.1 capability descriptor",
  "type": "object",
  "required": ["ase_version", "vendor", "model", "firmware", "tiers", "signal", "clock", "transport"],
  "additionalProperties": true,
  "properties": {
    "ase_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "vendor": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "firmware": { "type": "string", "minLength": 1 },
    "tiers": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["t0", "t1", "t2", "t3"] },
      "contains": { "const": "t1" }
    },
    "profiles": { "type": "array", "items": { "type": "string" } },
    "signal": {
      "type": "object",
      "required": ["kind", "channels", "montage", "sample_rate_hz"],
      "properties": {
        "kind": { "enum": ["semg", "eeg", "ecog", "spike", "eog", "imu", "mixed", "other"] },
        "channels": { "type": "integer", "minimum": 1 },
        "sample_rate_hz": { "type": "number", "exclusiveMinimum": 0 },
        "montage": {
          "type": "object",
          "required": ["system", "site", "side", "arrangement", "reference"],
          "properties": {
            "system": { "enum": ["ase.eeg.1020.v1", "ase.limb.v1", "ase.face.v1", "ase.opaque.v1"] },
            "site": { "type": "string", "minLength": 1 },
            "side": { "enum": ["left", "right", "midline", "bilateral", "n/a"] },
            "arrangement": { "enum": ["circumferential", "linear", "grid", "scattered", "single"] },
            "reference": { "type": "string", "minLength": 1 },
            "geometry_id": {
              "type": "string",
              "description": "R-4.2.1 — required for ase.opaque.v1: identical across units whose arrangement is interchangeable"
            },
            "positions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["ch"],
                "properties": {
                  "ch": { "type": "integer", "minimum": 0 },
                  "label": { "type": "string", "description": "ase.eeg.1020.v1" },
                  "muscle": { "type": "string", "description": "ase.face.v1" },
                  "angle_deg": { "type": "number", "minimum": 0, "exclusiveMaximum": 360, "description": "ase.limb.v1" },
                  "axial_mm": { "type": "number", "description": "ase.limb.v1" }
                }
              }
            }
          }
        }
      }
    },
    "t1": {
      "type": "object",
      "required": ["feature_space", "dim", "window_ms", "stride_ms", "producer", "documentation"],
      "properties": {
        "feature_space": { "type": "string", "minLength": 3 },
        "dim": { "type": "integer", "minimum": 1 },
        "window_ms": { "type": "number", "exclusiveMinimum": 0 },
        "stride_ms": { "type": "number", "exclusiveMinimum": 0 },
        "producer": { "enum": ["dsp", "model"] },
        "adaptive": { "type": "boolean", "default": false },
        "non_adaptive_mode": { "type": "boolean" },
        "adapt_scope": {
          "enum": ["frozen"],
          "description": "R-5.5.1 — present only when the per-user adaptation was fitted once, upstream of the exported values, and cannot be switched off. Requires non_adaptive_mode false and adapt_fitted_on."
        },
        "adapt_fitted_on": {
          "type": "string",
          "minLength": 10,
          "description": "R-5.5.1 — what was fitted, and on whose data."
        },
        "documentation": { "type": "string", "minLength": 1 },
        "latency_typ_ms": { "type": "number" },
        "latency_max_ms": { "type": "number" },
        "lossless_encodings": {
          "type": "array",
          "description": "R-9.1 — value encodings that stay within selftest tolerance",
          "items": { "enum": ["f32", "f16", "i16"] }
        },
        "cross_user_margin": {
          "type": "object",
          "description": "R-11.5 — optional. If a cross-user feature-space margin is claimed at all, it is only readable alongside the task it was measured on, the number of independent subjects, and the unit the interval was resampled over.",
          "required": ["margin", "ci_low", "ci_high", "task", "subjects", "bootstrap_unit"],
          "properties": {
            "margin": { "type": "number", "description": "mean score of the declared feature space minus its own channel-mean reduction" },
            "ci_low": { "type": "number" },
            "ci_high": { "type": "number" },
            "task": { "type": "string", "minLength": 3 },
            "subjects": { "type": "integer", "minimum": 2, "description": "independent subjects, not pairs" },
            "bootstrap_unit": {
              "enum": ["subject", "pair", "session", "trial"],
              "description": "the unit resampled; 'pair' is not independent when subjects recur across pairs"
            },
            "enrollment_samples": { "type": "integer", "minimum": 1, "description": "R-11.5.1" },
            "enrollment_donnings": { "type": "integer", "minimum": 1, "description": "R-11.5.1 — distinct donning sessions, not samples" },
            "enrollment_is_shipped": { "type": "boolean", "description": "R-11.5.1 — whether this is the enrollment the product ships with" },
            "pipeline": { "type": "string", "minLength": 3, "description": "R-11.5.2 — the transform from exported frames to retrieval score, identical in both arms" },
            "pipeline_scales_with_dim": { "type": "boolean", "description": "R-11.5.2 — whether any fitted step's parameter count scales with the feature dimension" },
            "margin_without_dim_scaled_step": { "type": "number", "description": "R-11.5.2 — required when pipeline_scales_with_dim is true" },
            "task_cardinality": { "type": "integer", "minimum": 2, "description": "R-11.5.3 — candidates per decision; the same space read -0.017 at 2 and +0.003 at 100 on THINGS-EEG2" },
            "task_trial_depth": { "type": "integer", "minimum": 1, "description": "R-11.5.3 — repetitions averaged into each exported frame the task scores" },
            "task_cue_selection": { "type": "string", "minLength": 3, "description": "R-11.5.3 — how the cue set was chosen; 'none' if no data was used to choose it" },
            "task_matches_product": { "type": "boolean", "description": "R-11.5.3 — whether cardinality and depth are the ones the product operates at" }
          }
        }
      }
    },
    "t0": {
      "type": "object",
      "required": ["event_space", "events", "documentation"],
      "description": "R-3.2.1 — required when tiers[] includes t0",
      "properties": {
        "event_space": { "type": "string", "minLength": 3 },
        "events": {
          "type": "array",
          "minItems": 1,
          "description": "the code -> label registry, sent once per session instead of per event",
          "items": {
            "type": "object",
            "required": ["code", "label"],
            "properties": {
              "code": { "type": "integer", "minimum": 0, "maximum": 65535 },
              "label": { "type": "string", "minLength": 1 }
            }
          }
        },
        "derived_from_t1": {
          "type": "boolean",
          "description": "R-3.2.2 — true when the recogniser runs on the exported feature space, in which case events carry t1_seq"
        },
        "confidence": {
          "type": "boolean",
          "default": true,
          "description": "R-3.2.1 — false for a recogniser with no posterior; such a device cannot use the ABF encoding for events (R-9.5)"
        },
        "documentation": { "type": "string", "minLength": 1 }
      }
    },
    "t2": {
      "type": "object",
      "required": ["channels", "sample_rate_hz", "unit", "layout", "filters"],
      "description": "R-3.3.1 — required when profiles[] includes ase.t2",
      "properties": {
        "channels": { "type": "integer", "minimum": 1 },
        "sample_rate_hz": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "enum": ["uV", "mV", "V", "g", "m/s^2", "deg/s", "T", "fT", "a.u."] },
        "layout": { "enum": ["channel-major", "sample-major"] },
        "filters": {
          "type": "array",
          "description": "the fixed stages, in the order applied; an empty array is a claim that none are",
          "items": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": { "enum": ["highpass", "lowpass", "bandpass", "bandstop", "notch", "decimate", "detrend", "car", "none"] },
              "hz": { "type": "number", "exclusiveMinimum": 0 },
              "hz_low": { "type": "number", "exclusiveMinimum": 0 },
              "hz_high": { "type": "number", "exclusiveMinimum": 0 },
              "order": { "type": "integer", "minimum": 1 },
              "q": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        }
      }
    },
    "t3": {
      "type": "object",
      "required": ["channels", "sample_rate_hz", "unit", "layout", "adc_bits", "lsb_per_unit"],
      "description": "R-3.3.1 — required when profiles[] includes ase.t3",
      "properties": {
        "channels": { "type": "integer", "minimum": 1 },
        "sample_rate_hz": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "enum": ["uV", "mV", "V", "g", "m/s^2", "deg/s", "T", "fT", "count"] },
        "layout": { "enum": ["channel-major", "sample-major"] },
        "adc_bits": { "type": "integer", "minimum": 1, "maximum": 32 },
        "lsb_per_unit": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "ADC counts per one of unit; the number that makes 'count' interpretable"
        }
      }
    },
    "clock": {
      "type": "object",
      "required": ["rtc", "mono_epoch"],
      "description": "R-4.3",
      "properties": {
        "rtc": { "type": "boolean" },
        "mono_epoch": { "enum": ["boot", "session"] },
        "drift_ppm_max": { "type": "number", "minimum": 0 }
      }
    },
    "selftest": {
      "type": "object",
      "required": ["input", "expected", "tolerance"],
      "description": "R-5.7 — production T1 transform over ase.selftest.v1, last window ending at or before 2.000 s",
      "properties": {
        "input": { "const": "ase.selftest.v1" },
        "expected": { "type": "array", "minItems": 1, "items": { "type": "number" } },
        "tolerance": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "previous_feature_space": {
      "type": "string",
      "description": "R-7.5.1 — feature space still obtainable after a change; required on any firmware that changed t1.feature_space"
    },
    "don_count": { "type": "integer", "minimum": 0 },
    "transport": {
      "type": "array",
      "minItems": 1,
      "description": "R-4.4",
      "items": {
        "type": "object",
        "required": ["uri", "encodings", "max_sustained_kbps"],
        "properties": {
          "uri": { "type": "string", "minLength": 1 },
          "encodings": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["json", "abf"] }
          },
          "max_sustained_kbps": { "type": "number", "exclusiveMinimum": 0 },
          "phy": { "type": "string", "description": "BLE only: 1M | 2M | coded" }
        }
      }
    },
    "requires_account": { "type": "boolean" },
    "requires_network": { "type": "boolean" },
    "developer_gate": {
      "type": "boolean",
      "description": "R-7.3 — true if T1 access is limited to an approved-developer programme; conformance requires false"
    },
    "terms": {
      "type": "object",
      "properties": {
        "cross_user_processing_permitted": { "type": "boolean", "description": "R-7.4" },
        "url": { "type": "string" }
      }
    }
  }
}
